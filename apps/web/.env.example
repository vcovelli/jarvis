DATABASE_URL="postgres://jarvis_app:Jarvis123@localhost:5432/jarvis"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Optional: keep hosted signups controlled until billing or invites are live.
REGISTRATION_DISABLED="false"
REGISTRATION_ACCESS_CODE=""

# Optional: voice transcription fallback when browser speech recognition is unavailable.
OPENAI_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_INTENT_MODEL="gpt-5"

# Optional: general assistant chat through an OpenClaw gateway.
OPENCLAW_GATEWAY_URL="ws://127.0.0.1:18789"
OPENCLAW_GATEWAY_TOKEN=""
OPENCLAW_GATEWAY_PASSWORD=""
OPENCLAW_GATEWAY_ROLE="operator"
OPENCLAW_AGENT_ID="main"
OPENCLAW_SESSION_PREFIX="agent:main:jarvis"
# Advanced: force low-level gateway calls into one session. Leave empty normally.
OPENCLAW_SESSION_KEY=""
# OPENCLAW_STATE_DIR defaults to ~/.openclaw. Explicit paths override files below it.
OPENCLAW_STATE_DIR=""
OPENCLAW_CONFIG_PATH=""
OPENCLAW_DEVICE_IDENTITY_PATH=""

# Optional: read-only finance integrations through Plaid.
# Product selection is handled by Jarvis connection modes:
# Bank / Credit Card -> transactions; Investment Account -> transactions,investments.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_COUNTRY_CODES="US"
PLAID_WEBHOOK_URL=""
PLAID_REDIRECT_URI=""

# Optional: external listing provider for the Real Estate module.
RENTCAST_API_KEY=""
RENTCAST_MONTHLY_LIMIT="50"
RENTCAST_MONTHLY_RESERVE="5"
RENTCAST_CACHE_TTL_HOURS="24"

# Optional but recommended: 64 hex chars from `openssl rand -hex 32`.
# Falls back to NEXTAUTH_SECRET when unset.
FINANCIAL_DATA_KEY=""

# Optional: local homelab monitoring integration.
PROMETHEUS_BASE_URL="http://127.0.0.1:9090"
GRAFANA_BASE_URL="http://100.115.58.56:3001"

# Optional: Markdown root used by the Homelab and Docs pages.
HOMELAB_DOCS_ROOT="/home/vcovelli/homelab-docs"
