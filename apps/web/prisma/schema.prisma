generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String?    @unique
  emailVerified DateTime?
  image        String?
  passwordHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  accounts              Account[]
  sessions              Session[]
  userState             UserState?
  financialConnections  FinancialConnection[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
  investmentHoldings    InvestmentHolding[]
  assistantConversations AssistantConversation[]
  assistantMessages      AssistantMessage[]
  assistantMemories      AssistantMemory[]
}

model UserState {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FinancialConnection {
  id                   String                 @id @default(cuid())
  userId               String
  provider             String                 @default("plaid")
  itemId               String
  accessTokenEncrypted String
  institutionId        String?
  institutionName      String?
  products             String[]
  cursor               String?
  status               String                 @default("active")
  lastSyncedAt         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts             FinancialAccount[]
  transactions         FinancialTransaction[]
  holdings             InvestmentHolding[]

  @@unique([userId, provider, itemId])
  @@index([userId])
}

model FinancialAccount {
  id                     String                 @id @default(cuid())
  userId                 String
  connectionId           String
  providerAccountId      String
  name                   String
  officialName           String?
  type                   String
  subtype                String?
  mask                   String?
  currentBalance         Float?
  availableBalance       Float?
  isoCurrencyCode        String?
  unofficialCurrencyCode String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection             FinancialConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions           FinancialTransaction[]
  holdings               InvestmentHolding[]

  @@unique([connectionId, providerAccountId])
  @@index([userId, type])
}

model FinancialTransaction {
  id                     String              @id @default(cuid())
  userId                 String
  connectionId           String
  accountId              String?
  providerTransactionId  String
  providerAccountId      String
  date                   DateTime
  authorizedDate         DateTime?
  name                   String
  merchantName           String?
  amount                 Float
  isoCurrencyCode        String?
  unofficialCurrencyCode String?
  category               String[]
  pending                Boolean             @default(false)
  paymentChannel         String?
  raw                    Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection             FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account                FinancialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerTransactionId])
  @@index([userId, date])
  @@index([accountId])
}

model InvestmentHolding {
  id                     String              @id @default(cuid())
  userId                 String
  connectionId           String
  accountId              String?
  holdingKey             String
  providerAccountId      String
  providerSecurityId     String?
  securityName           String?
  tickerSymbol           String?
  quantity               Float
  institutionPrice       Float?
  institutionValue       Float?
  costBasis              Float?
  isoCurrencyCode        String?
  unofficialCurrencyCode String?
  raw                    Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection             FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account                FinancialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([connectionId, holdingKey])
  @@index([userId])
  @@index([accountId])
}


model AssistantConversation {
  id                 String             @id @default(cuid())
  userId             String
  title              String             @default("New conversation")
  domain             String             @default("general")
  openClawSessionKey String
  description        String?
  summary            String?
  pinned             Boolean            @default(false)
  archivedAt         DateTime?
  lastMessageAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           AssistantMessage[]

  @@unique([userId, openClawSessionKey])
  @@index([userId, archivedAt, updatedAt])
  @@index([userId, domain])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  userId         String
  conversationId String
  role           String
  content        String
  source         String                @default("jarvis")
  tokenEstimate  Int                   @default(0)
  metadata       Json?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model AssistantMemory {
  id         String   @id @default(cuid())
  userId     String
  domain     String   @default("general")
  key        String
  value      String
  source     String   @default("manual")
  confidence Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain, key])
  @@index([userId, domain])
}

model Account {
  id                 String   @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
