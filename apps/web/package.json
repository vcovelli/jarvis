    "test:memory": "node --experimental-strip-types --test src/lib/memory/memory.test.ts src/lib/memory/streaming.test.ts src/lib/memory/evaluation/evaluation.test.ts src/lib/memory/evidence.test.ts",
    "test:memory:integration": "node --experimental-strip-types --test --test-concurrency=1 src/lib/memory/integration.test.ts",
